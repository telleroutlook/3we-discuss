{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "3we-discuss",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/worker.ts",

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "3we-discuss-db",
      "database_id": "b275bd5d-d87a-42b7-8e94-6bfac053a3ae"
    }
  ],

  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "64eefa977e2b4bf79f61d39fa02be9b2",
      "preview_id": "64eefa977e2b4bf79f61d39fa02be9b2"
    }
  ],

  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    }
  },

  "env": {
    "production": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "3we-discuss-db",
          "database_id": "b275bd5d-d87a-42b7-8e94-6bfac053a3ae"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "KV",
          "id": "64eefa977e2b4bf79f61d39fa02be9b2",
          "preview_id": "64eefa977e2b4bf79f61d39fa02be9b2"
        }
      ],
      "vars": {
        "APP_NAME": "3WE Discuss",
        "APP_VERSION": "0.1.0",
        "ENVIRONMENT": "production",
        "BASE_URL": "https://discussion.3we.org"
      },
      "routes": [
        { "pattern": "discussion.3we.org", "custom_domain": true }
      ]
    }
  }
}
